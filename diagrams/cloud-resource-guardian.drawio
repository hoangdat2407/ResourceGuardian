        </mxCell>
        <mxCell id="Nq7kKovAYJD0N4TU0IVM-12" parent="1" style="fillColor=none;strokeColor=#5A6C86;dashed=1;verticalAlign=top;fontStyle=0;fontColor=#5A6C86;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;strokeWidth=3;" value="&lt;code&gt;Resource information and usage metrics&lt;/code&gt;" vertex="1">
          <mxGeometry height="326" width="236" x="-1373" y="-196" as="geometry" />
        </mxCell>
      <mxCell id="detail1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="-1550" y="280" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail1_title" value="01 — Đăng nhập và Application backend" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="-1515" y="300" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail1_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="-1515" y="353" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail1_0" value="&lt;b&gt;01. Trình duyệt mở web&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web gồm dashboard, kết nối account, cấu hình rule, lịch quét và danh sách cảnh báo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="420" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_1" value="&lt;b&gt;02. Đăng nhập Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authorization Code + PKCE; người dùng đăng nhập trên Hosted UI. Web nhận access token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="420" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_2" value="&lt;b&gt;03. Gọi Amazon API Gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTTPS + Authorization: Bearer token. Không gửi AWS access key của người dùng qua web." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="420" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_3" value="&lt;b&gt;04. JWT authorizer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kiểm tra chữ ký, issuer, audience/client ID và hạn dùng. Token sai → 401; hợp lệ → Lambda." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="620" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_4" value="&lt;b&gt;05. Lambda Application backend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc sub từ JWT làm userId. Route request và kiểm tra dữ liệu đầu vào; không tin userId từ body." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="620" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_5" value="&lt;b&gt;06. Đọc / ghi DynamoDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Query trong partition USER#userId. Cấu hình và cảnh báo của mỗi người dùng được tách theo khóa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="620" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_6" value="&lt;b&gt;07. Các API chính&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /findings, GET /scans; PUT /settings; POST /connections; POST /scans; PATCH /findings/{id}." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="820" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_7" value="&lt;b&gt;08. Yêu cầu quét thủ công&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tạo scanId, ghi QUEUED, gọi Lambda quét bất đồng bộ với userId + scanId. Trả HTTP 202." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="820" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_8" value="&lt;b&gt;09. Hiển thị tiến độ và kết quả&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web gọi lại GET /scans/{id}; xem lý do, bằng chứng, region, thời gian và hướng dẫn xử lý." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="820" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail1_0" target="detail1_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail1_1" target="detail1_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail1_2" target="detail1_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail1_3" target="detail1_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail1_4" target="detail1_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail1_5" target="detail1_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail1_6" target="detail1_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail1_7" target="detail1_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Bố trí minh họa luồng chính; GET và PUT đi qua cùng backend, không phải mọi request đều tạo một lượt quét.&lt;br&gt;• API phải kiểm tra quyền sở hữu scan/finding trước khi đọc hoặc cập nhật; frontend chỉ giữ trạng thái phiên." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="1245" width="1420" height="140" as="geometry" /></mxCell><mxCell id="detail2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="-1550" y="1520" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail2_title" value="02 — Kết nối tài khoản AWS và STS" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="-1515" y="1540" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail2_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="-1515" y="1593" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail2_0" value="&lt;b&gt;01. Người dùng thêm AWS account&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhập account ID và region cần quét. Backend tạo ExternalId riêng cho kết nối và hướng dẫn tạo role." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="1660" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_1" value="&lt;b&gt;02. Tạo ResourceGuardianReadRole&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trong AWS account người dùng: triển khai template IAM/CloudFormation do platform cung cấp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="1660" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_2" value="&lt;b&gt;03. Trust policy của role&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chỉ tin ARN execution role của Lambda quét / kiểm tra kết nối; yêu cầu sts:ExternalId đúng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="1660" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_3" value="&lt;b&gt;04. Permission policy của role&lt;/b&gt;&lt;br&gt;&lt;br&gt;EC2: DescribeInstances, DescribeVolumes, DescribeAddresses, DescribeSnapshots, DescribeImages; CloudWatch: GetMetricData." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="1860" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_4" value="&lt;b&gt;05. Backend kiểm tra kết nối&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kiểm tra định dạng RoleArn, account và region. Dùng role kiểm tra kết nối được cấp AssumeRole đúng đích." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="1860" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_5" value="&lt;b&gt;06. STS AssumeRole&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gửi RoleArn + ExternalId + RoleSessionName. AWS kiểm tra quyền caller và trust policy của role đích." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="1860" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_6" value="&lt;b&gt;07. Credentials tạm thời&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhận AccessKeyId, SecretAccessKey, SessionToken, Expiration. Chỉ giữ trong bộ nhớ Lambda." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="2060" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_7" value="&lt;b&gt;08. Xác minh và lưu cấu hình&lt;/b&gt;&lt;br&gt;&lt;br&gt;GetCallerIdentity xác nhận account. DynamoDB lưu RoleArn, ExternalId, region, trạng thái kết nối." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="2060" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_8" value="&lt;b&gt;09. Dùng trong mỗi lượt quét&lt;/b&gt;&lt;br&gt;&lt;br&gt;Worker tự AssumeRole lại, tạo boto3.Session với credentials tạm; không lưu chúng vào database/log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="2060" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail2_0" target="detail2_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail2_1" target="detail2_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail2_2" target="detail2_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail2_3" target="detail2_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail2_4" target="detail2_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail2_5" target="detail2_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail2_6" target="detail2_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail2_7" target="detail2_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Quyền ghi database dùng execution role của platform; quyền đọc tài nguyên khách dùng credentials của assumed role.&lt;br&gt;• Role chỉ đọc không hỗ trợ stop/delete. Thu hồi role → quét báo AccessDenied và yêu cầu người dùng kết nối lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="2485" width="1420" height="140" as="geometry" /></mxCell><mxCell id="detail3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="-1550" y="2760" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail3_title" value="03 — EventBridge và điều phối lịch quét" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="-1515" y="2780" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail3_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="-1515" y="2833" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail3_0" value="&lt;b&gt;01. Amazon EventBridge&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rule định kỳ gọi hàm điều phối. MVP: tick mỗi giờ; lịch của từng người dùng lưu trong DynamoDB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="2900" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_1" value="&lt;b&gt;02. Hàm điều phối trong Lambda&lt;/b&gt;&lt;br&gt;&lt;br&gt;Một entry point riêng của module quét; nhận scheduled event, không dùng JWT từ trình duyệt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="2900" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_2" value="&lt;b&gt;03. Tìm kết nối đến hạn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Query chỉ mục lịch theo due bucket / nextScanAt; bỏ qua account ngắt kết nối hoặc tắt lịch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="2900" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_3" value="&lt;b&gt;04. Đọc settings của người dùng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc scanInterval, region, rule, emailEnabled. Ngưỡng và lịch được validate khi ghi cấu hình." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="3100" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_4" value="&lt;b&gt;05. Claim lượt quét nguyên tử&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conditional write theo connection + timeSlot: chỉ một lượt được claim; lock có lease hết hạn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="3100" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_5" value="&lt;b&gt;06. Tạo job và scanId&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ghi QUEUED, scheduledAt và request source. Payload chứa userId, connectionId, scanId." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="3100" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_6" value="&lt;b&gt;07. Gọi worker bất đồng bộ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lambda Invoke với InvocationType=Event; job nhỏ và có giới hạn tài nguyên cho MVP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="3300" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_7" value="&lt;b&gt;08. Cập nhật lần đến hạn kế tiếp&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sau khi nhận enqueue thành công, cập nhật nextScanAt. Nếu gửi lỗi, ghi lỗi và cho phép thử lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="3300" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_8" value="&lt;b&gt;09. Chống lặp và theo dõi lỗi&lt;/b&gt;&lt;br&gt;&lt;br&gt;Worker kiểm tra trạng thái job. Retry dùng cùng scanId; không tạo finding/email trùng một cách tùy ý." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="3300" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail3_0" target="detail3_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail3_1" target="detail3_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail3_2" target="detail3_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail3_3" target="detail3_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail3_4" target="detail3_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail3_5" target="detail3_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail3_6" target="detail3_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail3_7" target="detail3_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Sơ đồ mở rộng logic Lambda quét hiện có: entry point điều phối và worker có thể là hai function cùng codebase.&lt;br&gt;• Khi nhiều tenant/job: thêm SQS + DLQ và giới hạn concurrency; đây là phần mở rộng, chưa có trong tổng quan gốc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="3725" width="1420" height="140" as="geometry" /></mxCell><mxCell id="detail4_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="-1550" y="4000" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail4_title" value="04 — Lambda Resource assessment: code và AWS SDK" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="-1515" y="4020" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail4_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="-1515" y="4073" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail4_0" value="&lt;b&gt;01. handler(event, context)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhận userId, connectionId, scanId. Đọc lại cấu hình server-side, kiểm tra account đang được bật." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="4140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_1" value="&lt;b&gt;02. Claim job / RUNNING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conditional update trạng thái; kiểm tra lock và lượt đã hoàn tất. Ghi startedAt, deadline của lượt quét." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="4140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_2" value="&lt;b&gt;03. assume_customer_role()&lt;/b&gt;&lt;br&gt;&lt;br&gt;boto3 STS assume_role(RoleArn, ExternalId). Tạo session tạm dùng cho tất cả client của account khách." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="4140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_3" value="&lt;b&gt;04. collect_inventory(region)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tạo EC2 client theo region. Paginator DescribeInstances, Volumes, Addresses, Snapshots OwnerIds=[self]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="4340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_4" value="&lt;b&gt;05. collect_usage(region)&lt;/b&gt;&lt;br&gt;&lt;br&gt;CloudWatch GetMetricData: CPUUtilization, NetworkIn, NetworkOut theo InstanceId trong cửa sổ khảo sát." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="4340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_5" value="&lt;b&gt;06. normalize_observations()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chuẩn hóa account, region, type, id, tags, trạng thái, metric và timestamps; giữ nguồn bằng chứng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="4340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_6" value="&lt;b&gt;07. evaluate_rules()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dùng ngưỡng trong settings + lịch sử quan sát. Không coi dữ liệu thiếu là 0; phân loại cần kiểm tra." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="4540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_7" value="&lt;b&gt;08. apply_exclusions()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bỏ qua allowlist / tag bảo vệ / finding được ignore. Không suy ra mọi tài nguyên ít dùng đều là rác." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="4540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_8" value="&lt;b&gt;09. persist_findings()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upsert khóa user + account + region + type + resourceId + ruleId; lưu reason, evidence, first/lastSeen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="4540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_9" value="&lt;b&gt;10. prepare_notification()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chọn finding mới / còn hiệu lực và qua cooldown. Nếu bật email, gửi digest bằng SES; lưu trạng thái gửi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="4740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_10" value="&lt;b&gt;11. finalize_scan()&lt;/b&gt;&lt;br&gt;&lt;br&gt;SUCCEEDED nếu quét đủ; PARTIAL nếu có region/API thiếu; FAILED nếu không quét được. Ghi summary và lỗi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="4740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_11" value="&lt;b&gt;12. Release lock và trả kết quả&lt;/b&gt;&lt;br&gt;&lt;br&gt;finally giải phóng lease đúng chủ sở hữu; log scanId, số resource, thời gian. Web đọc kết quả từ database." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="4740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail4_0" target="detail4_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail4_1" target="detail4_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail4_2" target="detail4_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail4_3" target="detail4_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail4_4" target="detail4_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail4_5" target="detail4_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail4_6" target="detail4_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail4_7" target="detail4_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail4_8" target="detail4_9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail4_9" target="detail4_10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail4_10" target="detail4_11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Vòng lặp bước 4–9 chạy cho từng region được cho phép; retry API bằng exponential backoff có jitter và số lần giới hạn.&lt;br&gt;• Giới hạn thời gian/số resource; chạm ngưỡng hoặc thiếu trang phải báo PARTIAL. Không tuyên bố toàn bộ account đã sạch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="4965" width="1420" height="140" as="geometry" /></mxCell><mxCell id="detail5_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="-1550" y="5240" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail5_title" value="05 — Rule engine cho bốn loại tài nguyên" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="-1515" y="5260" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail5_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="-1515" y="5313" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail5_0" value="&lt;b&gt;01. EC2: thu thập bằng chứng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chỉ đánh giá instance running; kết hợp CPU và NetworkIn/Out, cửa sổ thời gian và độ phủ metric." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="5380" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_1" value="&lt;b&gt;02. EC2: rule ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trong 7 ngày, ít nhất 90% điểm CPU &amp;lt; 5% và mạng thấp theo ngưỡng; phải đủ mẫu dữ liệu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="5380" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_2" value="&lt;b&gt;03. EC2: giải thích finding&lt;/b&gt;&lt;br&gt;&lt;br&gt;Low utilization → đề nghị kiểm tra lịch chạy/backup/job batch. Dữ liệu thiếu → UNKNOWN, chưa kết luận idle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="5380" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_3" value="&lt;b&gt;04. EBS volume: trạng thái&lt;/b&gt;&lt;br&gt;&lt;br&gt;State=available và Attachments rỗng. Lưu firstObservedUnattached, reset khi volume attach lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="5580" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_4" value="&lt;b&gt;05. EBS: rule ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quan sát không attach liên tục ≥ 24 giờ qua nhiều lượt quét. CreateTime không phải thời điểm detach." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="5580" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_5" value="&lt;b&gt;06. EBS: bằng chứng và xử lý&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hiện size/type, region, thời gian quan sát. Người dùng kiểm tra dữ liệu và backup trước khi xử lý ngoài app." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="5580" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_6" value="&lt;b&gt;07. Elastic IP: liên kết&lt;/b&gt;&lt;br&gt;&lt;br&gt;DescribeAddresses: AssociationId, InstanceId, NetworkInterfaceId; kiểm tra liên kết với ENI, không chỉ EC2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="5780" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_7" value="&lt;b&gt;08. Elastic IP: rule ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Không có association trong ≥ 24 giờ theo lịch sử quan sát; có association thì reset bộ đếm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="5780" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_8" value="&lt;b&gt;09. Elastic IP: giải thích finding&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hiện allocation ID, region và lịch sử chưa liên kết; người dùng xác minh DNS / nhu cầu IP tĩnh trước khi release." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="5780" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_9" value="&lt;b&gt;10. Snapshot: kiểm tra thận trọng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Snapshot tự sở hữu, trạng thái completed, tuổi &amp;gt; ngưỡng; đối chiếu DescribeImages / BlockDeviceMappings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="5980" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_10" value="&lt;b&gt;11. Snapshot: kết quả review&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tuổi &amp;gt; 30 ngày là tín hiệu rà soát. Gắn với AMI, backup policy hoặc tag giữ lại → không đề nghị xóa tự động." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="5980" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_11" value="&lt;b&gt;12. Finding có thể giải thích&lt;/b&gt;&lt;br&gt;&lt;br&gt;resourceId + ruleId + severity + reason + evidence + status; không tự tính tiền tiết kiệm nếu thiếu giá phù hợp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="5980" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail5_0" target="detail5_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail5_1" target="detail5_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail5_3" target="detail5_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail5_4" target="detail5_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail5_6" target="detail5_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail5_7" target="detail5_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail5_9" target="detail5_10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail5_10" target="detail5_11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Bốn hàng là bốn rule độc lập. Áp dụng rule enabled, protected tag và ignoreUntil trước khi tạo finding; ngưỡng được validate.&lt;br&gt;• EBS và EIP cần quan sát nhiều lần; snapshot cũ vẫn có thể là bản sao lưu cần giữ. Kết quả là khuyến nghị kiểm tra." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="6205" width="1420" height="140" as="geometry" /></mxCell><mxCell id="detail6_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="-1550" y="6480" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail6_title" value="06 — DynamoDB: dữ liệu nhiều người dùng" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="-1515" y="6500" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail6_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="-1515" y="6553" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail6_0" value="&lt;b&gt;01. Partition theo người dùng&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK=USER#&amp;lt;Cognito sub&amp;gt;. Backend tạo khóa từ JWT; worker nhận userId từ job nội bộ đã kiểm tra." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="6620" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_1" value="&lt;b&gt;02. Connection item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=CONNECTION#id; accountId, RoleArn, ExternalId, regions, enabled, connectionStatus." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="6620" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_2" value="&lt;b&gt;03. Settings item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=SETTINGS; thresholds, scanInterval, emailEnabled, verified recipient, protected tags." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="6620" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_3" value="&lt;b&gt;04. Scan item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=SCAN#timestamp#scanId; QUEUED/RUNNING/SUCCEEDED/PARTIAL/FAILED, counts, error summary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="6820" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_4" value="&lt;b&gt;05. Observation item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=OBS#account#region#type#id; lastState, firstObservedUnattached, lastObservedAt, metric coverage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="6820" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_5" value="&lt;b&gt;06. Finding item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=FINDING#account#region#type#id#rule; reason, evidence, firstSeen, lastSeen, status, ignoreUntil." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="6820" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_6" value="&lt;b&gt;07. Lock / job item&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conditional write + leaseExpiresAt. Chỉ worker sở hữu lease được finalize/release; chống quét trùng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="7020" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_7" value="&lt;b&gt;08. Notification item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=NOTIFY#scanId#digest; PENDING/SENT/FAILED, sentAt, retryCount, SES messageId nếu có." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="7020" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_8" value="&lt;b&gt;09. Đọc dữ liệu có phân trang&lt;/b&gt;&lt;br&gt;&lt;br&gt;Query theo PK, Limit và LastEvaluatedKey; API trả cursor. Không Scan toàn bảng cho mỗi dashboard." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="7020" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_9" value="&lt;b&gt;10. Chỉ mục lịch quét&lt;/b&gt;&lt;br&gt;&lt;br&gt;GSI due bucket + nextScanAt hỗ trợ scheduler; shard/bucket khi tăng lượng kết nối." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="7220" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_10" value="&lt;b&gt;11. Retention và trạng thái&lt;/b&gt;&lt;br&gt;&lt;br&gt;TTL cho lịch sử theo chính sách; TTL xóa không tức thời. Lock hết hạn được kiểm tra bằng timestamp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="7220" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_11" value="&lt;b&gt;12. Bảo vệ tenant và credentials&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tenant isolation kiểm tra bằng code và test. Không lưu AWS temporary credentials hay token Cognito vào item." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="7220" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Mô hình item dự kiến cho một bảng DynamoDB; dùng projection/GSI phù hợp theo truy vấn thực tế.&lt;br&gt;• Các ô là danh mục dữ liệu, không phải chuỗi thao tác. Chỉ resolve finding khi quét đủ; không resolve do scan lỗi/partial." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="7445" width="1420" height="140" as="geometry" /></mxCell><mxCell id="detail7_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="-1550" y="7720" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail7_title" value="07 — Cảnh báo web và email với SES" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="-1515" y="7740" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail7_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="-1515" y="7793" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail7_0" value="&lt;b&gt;01. Worker lưu finding trước&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dashboard đọc kết quả từ DynamoDB. Cảnh báo web vẫn dùng được khi email bị tắt hoặc gửi lỗi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="7860" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_1" value="&lt;b&gt;02. Kiểm tra cấu hình email&lt;/b&gt;&lt;br&gt;&lt;br&gt;emailEnabled + địa chỉ người dùng đã xác minh; chỉ gửi tới người sở hữu account, không lấy recipient từ job." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="7860" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_2" value="&lt;b&gt;03. Chọn finding cần thông báo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Finding mới/đổi đáng kể, không ignored; áp dụng cooldown và gom thành một digest mỗi lượt quét." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="7860" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_3" value="&lt;b&gt;04. Tạo notification record&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conditional write giữ notificationId ổn định; chống gửi lặp khi scheduled event/worker được retry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="8060" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_4" value="&lt;b&gt;05. Soạn email có bằng chứng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Resource, account, region, lý do, thời gian và link dashboard. Không kèm credentials hay dữ liệu nhạy cảm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="8060" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_5" value="&lt;b&gt;06. Amazon SES SendEmail&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lambda dùng execution role có ses:SendEmail; sender identity được xác minh trong region triển khai." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="8060" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_6" value="&lt;b&gt;07. SES chấp nhận yêu cầu&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lưu messageId và SENT nghĩa là SES nhận gửi; không đồng nghĩa email đã tới inbox." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="8260" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_7" value="&lt;b&gt;08. Nếu SES lỗi / bị throttle&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ghi FAILED và retry có giới hạn; không đánh dấu scan tài nguyên FAILED chỉ vì gửi email lỗi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="8260" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_8" value="&lt;b&gt;09. Theo dõi gửi khi mở rộng&lt;/b&gt;&lt;br&gt;&lt;br&gt;SES events cho bounce/complaint/delivery; suppress recipient lỗi. Cấu hình SES sandbox cần xác minh recipient." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="8260" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail7_0" target="detail7_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail7_1" target="detail7_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail7_2" target="detail7_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail7_3" target="detail7_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail7_4" target="detail7_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail7_5" target="detail7_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Email là thành phần dự kiến trong mô hình bạn vẽ; cần cấu hình identity/quyền trước khi demo gửi thật.&lt;br&gt;• SES không bảo đảm exactly-once SendEmail. Record + cooldown giảm trùng; crash sau gửi có thể khiến kết quả gửi chưa rõ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="8685" width="1420" height="140" as="geometry" /></mxCell><mxCell id="detail8_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="-1550" y="8960" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail8_title" value="08 — Vận hành, quyền và luồng xử lý của người dùng" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="-1515" y="8980" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail8_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="-1515" y="9033" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail8_0" value="&lt;b&gt;01. Frontend hosting cần bổ sung&lt;/b&gt;&lt;br&gt;&lt;br&gt;S3 + CloudFront phục vụ HTML/JS qua HTTPS, hoặc hosting tương đương. Browser không phải dịch vụ lưu web." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="9100" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_1" value="&lt;b&gt;02. Dashboard tập trung&lt;/b&gt;&lt;br&gt;&lt;br&gt;Xem trạng thái kết nối, lần quét gần nhất, lỗi/partial, bộ lọc resource/region và bằng chứng cảnh báo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="9100" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_2" value="&lt;b&gt;03. Cấu hình qua form&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validate ngưỡng, thời gian, region; người dùng bật/tắt lịch, quét thủ công, ignore và thêm tag ngoại lệ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="9100" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_3" value="&lt;b&gt;04. Kiểm tra trước khi xử lý&lt;/b&gt;&lt;br&gt;&lt;br&gt;Người dùng mở tài nguyên trong AWS Console, xác minh mục đích và ảnh hưởng tới ứng dụng/backup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="9300" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_4" value="&lt;b&gt;05. Xử lý theo quyền hiện tại&lt;/b&gt;&lt;br&gt;&lt;br&gt;ReadRole chỉ đọc. MVP hướng dẫn stop/delete qua AWS Console rồi quét lại để xác nhận kết quả." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="9300" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_5" value="&lt;b&gt;06. Tự động thao tác: mở rộng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nếu làm sau: ActionRole riêng, preview ảnh hưởng, xác nhận từng resource, recheck trạng thái và audit log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="9300" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_6" value="&lt;b&gt;07. Execution role riêng từng Lambda&lt;/b&gt;&lt;br&gt;&lt;br&gt;API: DynamoDB + Invoke worker; scheduler: lịch/job + Invoke; worker: STS + DynamoDB + SES + logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="9500" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_7" value="&lt;b&gt;08. CloudWatch Logs và Metrics&lt;/b&gt;&lt;br&gt;&lt;br&gt;Log có scanId/userId nội bộ, latency, counts, errors; tránh credentials, token và nội dung email đầy đủ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="9500" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_8" value="&lt;b&gt;09. CloudWatch Alarm&lt;/b&gt;&lt;br&gt;&lt;br&gt;Theo dõi Lambda Errors/Throttles, duration, scan overdue, tỷ lệ partial và thất bại gửi email." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="9500" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_9" value="&lt;b&gt;10. Giới hạn chi phí và tải&lt;/b&gt;&lt;br&gt;&lt;br&gt;Region allowlist, số resource, lịch tối thiểu, reserved concurrency. SDK paginate có giới hạn rõ ràng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-510" y="9700" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_10" value="&lt;b&gt;11. Kiểm thử các tình huống&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hai user không đọc chéo; role bị thu hồi; metric thiếu; throttle; event lặp; scan partial; snapshot giữ lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1010" y="9700" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_11" value="&lt;b&gt;12. Demo có thể kiểm chứng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tạo tài nguyên thử được phép, chạy quét, xem evidence, ignore, đổi ngưỡng và quét lại; ghi nhận kết quả thực tế." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="9700" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail8_0" target="detail8_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail8_1" target="detail8_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail8_2" target="detail8_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail8_3" target="detail8_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail8_4" target="detail8_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Các khối S3/CloudFront, monitoring và ActionRole được ghi rõ là bổ sung/mở rộng so với sơ đồ tổng quan gốc.&lt;br&gt;• Đây là thiết kế chi tiết dự kiến; hình vẽ không chứng minh hệ thống đã triển khai hoặc đã kiểm thử trên AWS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="-1510" y="9925" width="1420" height="140" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
<diagram id="crg-detail-1" name="01 — Đăng nhập và Application backend"><mxGraphModel dx="1500" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="detail1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail1_title" value="01 — Đăng nhập và Application backend" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail1_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="73" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail1_0" value="&lt;b&gt;01. Trình duyệt mở web&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web gồm dashboard, kết nối account, cấu hình rule, lịch quét và danh sách cảnh báo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_1" value="&lt;b&gt;02. Đăng nhập Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authorization Code + PKCE; người dùng đăng nhập trên Hosted UI. Web nhận access token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_2" value="&lt;b&gt;03. Gọi Amazon API Gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTTPS + Authorization: Bearer token. Không gửi AWS access key của người dùng qua web." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_3" value="&lt;b&gt;04. JWT authorizer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kiểm tra chữ ký, issuer, audience/client ID và hạn dùng. Token sai → 401; hợp lệ → Lambda." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_4" value="&lt;b&gt;05. Lambda Application backend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc sub từ JWT làm userId. Route request và kiểm tra dữ liệu đầu vào; không tin userId từ body." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_5" value="&lt;b&gt;06. Đọc / ghi DynamoDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Query trong partition USER#userId. Cấu hình và cảnh báo của mỗi người dùng được tách theo khóa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_6" value="&lt;b&gt;07. Các API chính&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /findings, GET /scans; PUT /settings; POST /connections; POST /scans; PATCH /findings/{id}." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_7" value="&lt;b&gt;08. Yêu cầu quét thủ công&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tạo scanId, ghi QUEUED, gọi Lambda quét bất đồng bộ với userId + scanId. Trả HTTP 202." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_8" value="&lt;b&gt;09. Hiển thị tiến độ và kết quả&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web gọi lại GET /scans/{id}; xem lý do, bằng chứng, region, thời gian và hướng dẫn xử lý." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail1_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail1_0" target="detail1_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail1_1" target="detail1_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail1_2" target="detail1_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail1_3" target="detail1_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail1_4" target="detail1_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail1_5" target="detail1_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail1_6" target="detail1_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail1_7" target="detail1_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail1_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Bố trí minh họa luồng chính; GET và PUT đi qua cùng backend, không phải mọi request đều tạo một lượt quét.&lt;br&gt;• API phải kiểm tra quyền sở hữu scan/finding trước khi đọc hoặc cập nhật; frontend chỉ giữ trạng thái phiên." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="crg-detail-2" name="02 — Kết nối tài khoản AWS và STS"><mxGraphModel dx="1500" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="detail2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail2_title" value="02 — Kết nối tài khoản AWS và STS" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail2_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="73" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail2_0" value="&lt;b&gt;01. Người dùng thêm AWS account&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhập account ID và region cần quét. Backend tạo ExternalId riêng cho kết nối và hướng dẫn tạo role." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_1" value="&lt;b&gt;02. Tạo ResourceGuardianReadRole&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trong AWS account người dùng: triển khai template IAM/CloudFormation do platform cung cấp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_2" value="&lt;b&gt;03. Trust policy của role&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chỉ tin ARN execution role của Lambda quét / kiểm tra kết nối; yêu cầu sts:ExternalId đúng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_3" value="&lt;b&gt;04. Permission policy của role&lt;/b&gt;&lt;br&gt;&lt;br&gt;EC2: DescribeInstances, DescribeVolumes, DescribeAddresses, DescribeSnapshots, DescribeImages; CloudWatch: GetMetricData." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_4" value="&lt;b&gt;05. Backend kiểm tra kết nối&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kiểm tra định dạng RoleArn, account và region. Dùng role kiểm tra kết nối được cấp AssumeRole đúng đích." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_5" value="&lt;b&gt;06. STS AssumeRole&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gửi RoleArn + ExternalId + RoleSessionName. AWS kiểm tra quyền caller và trust policy của role đích." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_6" value="&lt;b&gt;07. Credentials tạm thời&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhận AccessKeyId, SecretAccessKey, SessionToken, Expiration. Chỉ giữ trong bộ nhớ Lambda." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_7" value="&lt;b&gt;08. Xác minh và lưu cấu hình&lt;/b&gt;&lt;br&gt;&lt;br&gt;GetCallerIdentity xác nhận account. DynamoDB lưu RoleArn, ExternalId, region, trạng thái kết nối." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_8" value="&lt;b&gt;09. Dùng trong mỗi lượt quét&lt;/b&gt;&lt;br&gt;&lt;br&gt;Worker tự AssumeRole lại, tạo boto3.Session với credentials tạm; không lưu chúng vào database/log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail2_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail2_0" target="detail2_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail2_1" target="detail2_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail2_2" target="detail2_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail2_3" target="detail2_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail2_4" target="detail2_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail2_5" target="detail2_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail2_6" target="detail2_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail2_7" target="detail2_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail2_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Quyền ghi database dùng execution role của platform; quyền đọc tài nguyên khách dùng credentials của assumed role.&lt;br&gt;• Role chỉ đọc không hỗ trợ stop/delete. Thu hồi role → quét báo AccessDenied và yêu cầu người dùng kết nối lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="crg-detail-3" name="03 — EventBridge và điều phối lịch quét"><mxGraphModel dx="1500" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="detail3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail3_title" value="03 — EventBridge và điều phối lịch quét" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail3_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="73" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail3_0" value="&lt;b&gt;01. Amazon EventBridge&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rule định kỳ gọi hàm điều phối. MVP: tick mỗi giờ; lịch của từng người dùng lưu trong DynamoDB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_1" value="&lt;b&gt;02. Hàm điều phối trong Lambda&lt;/b&gt;&lt;br&gt;&lt;br&gt;Một entry point riêng của module quét; nhận scheduled event, không dùng JWT từ trình duyệt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_2" value="&lt;b&gt;03. Tìm kết nối đến hạn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Query chỉ mục lịch theo due bucket / nextScanAt; bỏ qua account ngắt kết nối hoặc tắt lịch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_3" value="&lt;b&gt;04. Đọc settings của người dùng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc scanInterval, region, rule, emailEnabled. Ngưỡng và lịch được validate khi ghi cấu hình." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_4" value="&lt;b&gt;05. Claim lượt quét nguyên tử&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conditional write theo connection + timeSlot: chỉ một lượt được claim; lock có lease hết hạn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_5" value="&lt;b&gt;06. Tạo job và scanId&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ghi QUEUED, scheduledAt và request source. Payload chứa userId, connectionId, scanId." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_6" value="&lt;b&gt;07. Gọi worker bất đồng bộ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lambda Invoke với InvocationType=Event; job nhỏ và có giới hạn tài nguyên cho MVP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_7" value="&lt;b&gt;08. Cập nhật lần đến hạn kế tiếp&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sau khi nhận enqueue thành công, cập nhật nextScanAt. Nếu gửi lỗi, ghi lỗi và cho phép thử lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_8" value="&lt;b&gt;09. Chống lặp và theo dõi lỗi&lt;/b&gt;&lt;br&gt;&lt;br&gt;Worker kiểm tra trạng thái job. Retry dùng cùng scanId; không tạo finding/email trùng một cách tùy ý." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail3_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail3_0" target="detail3_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail3_1" target="detail3_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail3_2" target="detail3_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail3_3" target="detail3_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail3_4" target="detail3_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail3_5" target="detail3_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail3_6" target="detail3_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail3_7" target="detail3_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail3_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Sơ đồ mở rộng logic Lambda quét hiện có: entry point điều phối và worker có thể là hai function cùng codebase.&lt;br&gt;• Khi nhiều tenant/job: thêm SQS + DLQ và giới hạn concurrency; đây là phần mở rộng, chưa có trong tổng quan gốc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="crg-detail-4" name="04 — Lambda Resource assessment: code và AWS SDK"><mxGraphModel dx="1500" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="detail4_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail4_title" value="04 — Lambda Resource assessment: code và AWS SDK" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail4_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="73" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail4_0" value="&lt;b&gt;01. handler(event, context)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhận userId, connectionId, scanId. Đọc lại cấu hình server-side, kiểm tra account đang được bật." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_1" value="&lt;b&gt;02. Claim job / RUNNING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conditional update trạng thái; kiểm tra lock và lượt đã hoàn tất. Ghi startedAt, deadline của lượt quét." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_2" value="&lt;b&gt;03. assume_customer_role()&lt;/b&gt;&lt;br&gt;&lt;br&gt;boto3 STS assume_role(RoleArn, ExternalId). Tạo session tạm dùng cho tất cả client của account khách." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_3" value="&lt;b&gt;04. collect_inventory(region)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tạo EC2 client theo region. Paginator DescribeInstances, Volumes, Addresses, Snapshots OwnerIds=[self]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_4" value="&lt;b&gt;05. collect_usage(region)&lt;/b&gt;&lt;br&gt;&lt;br&gt;CloudWatch GetMetricData: CPUUtilization, NetworkIn, NetworkOut theo InstanceId trong cửa sổ khảo sát." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_5" value="&lt;b&gt;06. normalize_observations()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chuẩn hóa account, region, type, id, tags, trạng thái, metric và timestamps; giữ nguồn bằng chứng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_6" value="&lt;b&gt;07. evaluate_rules()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dùng ngưỡng trong settings + lịch sử quan sát. Không coi dữ liệu thiếu là 0; phân loại cần kiểm tra." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_7" value="&lt;b&gt;08. apply_exclusions()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bỏ qua allowlist / tag bảo vệ / finding được ignore. Không suy ra mọi tài nguyên ít dùng đều là rác." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_8" value="&lt;b&gt;09. persist_findings()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upsert khóa user + account + region + type + resourceId + ruleId; lưu reason, evidence, first/lastSeen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_9" value="&lt;b&gt;10. prepare_notification()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chọn finding mới / còn hiệu lực và qua cooldown. Nếu bật email, gửi digest bằng SES; lưu trạng thái gửi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_10" value="&lt;b&gt;11. finalize_scan()&lt;/b&gt;&lt;br&gt;&lt;br&gt;SUCCEEDED nếu quét đủ; PARTIAL nếu có region/API thiếu; FAILED nếu không quét được. Ghi summary và lỗi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_11" value="&lt;b&gt;12. Release lock và trả kết quả&lt;/b&gt;&lt;br&gt;&lt;br&gt;finally giải phóng lease đúng chủ sở hữu; log scanId, số resource, thời gian. Web đọc kết quả từ database." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail4_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail4_0" target="detail4_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail4_1" target="detail4_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail4_2" target="detail4_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail4_3" target="detail4_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail4_4" target="detail4_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail4_5" target="detail4_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail4_6" target="detail4_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail4_7" target="detail4_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail4_8" target="detail4_9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail4_9" target="detail4_10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail4_10" target="detail4_11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail4_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Vòng lặp bước 4–9 chạy cho từng region được cho phép; retry API bằng exponential backoff có jitter và số lần giới hạn.&lt;br&gt;• Giới hạn thời gian/số resource; chạm ngưỡng hoặc thiếu trang phải báo PARTIAL. Không tuyên bố toàn bộ account đã sạch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="crg-detail-5" name="05 — Rule engine cho bốn loại tài nguyên"><mxGraphModel dx="1500" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="detail5_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail5_title" value="05 — Rule engine cho bốn loại tài nguyên" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail5_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="73" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail5_0" value="&lt;b&gt;01. EC2: thu thập bằng chứng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chỉ đánh giá instance running; kết hợp CPU và NetworkIn/Out, cửa sổ thời gian và độ phủ metric." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_1" value="&lt;b&gt;02. EC2: rule ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trong 7 ngày, ít nhất 90% điểm CPU &amp;lt; 5% và mạng thấp theo ngưỡng; phải đủ mẫu dữ liệu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_2" value="&lt;b&gt;03. EC2: giải thích finding&lt;/b&gt;&lt;br&gt;&lt;br&gt;Low utilization → đề nghị kiểm tra lịch chạy/backup/job batch. Dữ liệu thiếu → UNKNOWN, chưa kết luận idle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_3" value="&lt;b&gt;04. EBS volume: trạng thái&lt;/b&gt;&lt;br&gt;&lt;br&gt;State=available và Attachments rỗng. Lưu firstObservedUnattached, reset khi volume attach lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_4" value="&lt;b&gt;05. EBS: rule ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quan sát không attach liên tục ≥ 24 giờ qua nhiều lượt quét. CreateTime không phải thời điểm detach." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_5" value="&lt;b&gt;06. EBS: bằng chứng và xử lý&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hiện size/type, region, thời gian quan sát. Người dùng kiểm tra dữ liệu và backup trước khi xử lý ngoài app." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_6" value="&lt;b&gt;07. Elastic IP: liên kết&lt;/b&gt;&lt;br&gt;&lt;br&gt;DescribeAddresses: AssociationId, InstanceId, NetworkInterfaceId; kiểm tra liên kết với ENI, không chỉ EC2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_7" value="&lt;b&gt;08. Elastic IP: rule ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Không có association trong ≥ 24 giờ theo lịch sử quan sát; có association thì reset bộ đếm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_8" value="&lt;b&gt;09. Elastic IP: giải thích finding&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hiện allocation ID, region và lịch sử chưa liên kết; người dùng xác minh DNS / nhu cầu IP tĩnh trước khi release." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_9" value="&lt;b&gt;10. Snapshot: kiểm tra thận trọng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Snapshot tự sở hữu, trạng thái completed, tuổi &amp;gt; ngưỡng; đối chiếu DescribeImages / BlockDeviceMappings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_10" value="&lt;b&gt;11. Snapshot: kết quả review&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tuổi &amp;gt; 30 ngày là tín hiệu rà soát. Gắn với AMI, backup policy hoặc tag giữ lại → không đề nghị xóa tự động." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_11" value="&lt;b&gt;12. Finding có thể giải thích&lt;/b&gt;&lt;br&gt;&lt;br&gt;resourceId + ruleId + severity + reason + evidence + status; không tự tính tiền tiết kiệm nếu thiếu giá phù hợp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail5_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail5_0" target="detail5_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail5_1" target="detail5_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail5_3" target="detail5_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail5_4" target="detail5_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail5_6" target="detail5_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail5_7" target="detail5_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail5_9" target="detail5_10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail5_10" target="detail5_11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail5_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Bốn hàng là bốn rule độc lập. Áp dụng rule enabled, protected tag và ignoreUntil trước khi tạo finding; ngưỡng được validate.&lt;br&gt;• EBS và EIP cần quan sát nhiều lần; snapshot cũ vẫn có thể là bản sao lưu cần giữ. Kết quả là khuyến nghị kiểm tra." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="crg-detail-6" name="06 — DynamoDB: dữ liệu nhiều người dùng"><mxGraphModel dx="1500" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="detail6_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail6_title" value="06 — DynamoDB: dữ liệu nhiều người dùng" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail6_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="73" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail6_0" value="&lt;b&gt;01. Partition theo người dùng&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK=USER#&amp;lt;Cognito sub&amp;gt;. Backend tạo khóa từ JWT; worker nhận userId từ job nội bộ đã kiểm tra." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_1" value="&lt;b&gt;02. Connection item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=CONNECTION#id; accountId, RoleArn, ExternalId, regions, enabled, connectionStatus." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_2" value="&lt;b&gt;03. Settings item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=SETTINGS; thresholds, scanInterval, emailEnabled, verified recipient, protected tags." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_3" value="&lt;b&gt;04. Scan item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=SCAN#timestamp#scanId; QUEUED/RUNNING/SUCCEEDED/PARTIAL/FAILED, counts, error summary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_4" value="&lt;b&gt;05. Observation item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=OBS#account#region#type#id; lastState, firstObservedUnattached, lastObservedAt, metric coverage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_5" value="&lt;b&gt;06. Finding item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=FINDING#account#region#type#id#rule; reason, evidence, firstSeen, lastSeen, status, ignoreUntil." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_6" value="&lt;b&gt;07. Lock / job item&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conditional write + leaseExpiresAt. Chỉ worker sở hữu lease được finalize/release; chống quét trùng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_7" value="&lt;b&gt;08. Notification item&lt;/b&gt;&lt;br&gt;&lt;br&gt;SK=NOTIFY#scanId#digest; PENDING/SENT/FAILED, sentAt, retryCount, SES messageId nếu có." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_8" value="&lt;b&gt;09. Đọc dữ liệu có phân trang&lt;/b&gt;&lt;br&gt;&lt;br&gt;Query theo PK, Limit và LastEvaluatedKey; API trả cursor. Không Scan toàn bảng cho mỗi dashboard." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_9" value="&lt;b&gt;10. Chỉ mục lịch quét&lt;/b&gt;&lt;br&gt;&lt;br&gt;GSI due bucket + nextScanAt hỗ trợ scheduler; shard/bucket khi tăng lượng kết nối." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_10" value="&lt;b&gt;11. Retention và trạng thái&lt;/b&gt;&lt;br&gt;&lt;br&gt;TTL cho lịch sử theo chính sách; TTL xóa không tức thời. Lock hết hạn được kiểm tra bằng timestamp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_11" value="&lt;b&gt;12. Bảo vệ tenant và credentials&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tenant isolation kiểm tra bằng code và test. Không lưu AWS temporary credentials hay token Cognito vào item." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail6_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Mô hình item dự kiến cho một bảng DynamoDB; dùng projection/GSI phù hợp theo truy vấn thực tế.&lt;br&gt;• Các ô là danh mục dữ liệu, không phải chuỗi thao tác. Chỉ resolve finding khi quét đủ; không resolve do scan lỗi/partial." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="crg-detail-7" name="07 — Cảnh báo web và email với SES"><mxGraphModel dx="1500" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="detail7_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail7_title" value="07 — Cảnh báo web và email với SES" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail7_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="73" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail7_0" value="&lt;b&gt;01. Worker lưu finding trước&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dashboard đọc kết quả từ DynamoDB. Cảnh báo web vẫn dùng được khi email bị tắt hoặc gửi lỗi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_1" value="&lt;b&gt;02. Kiểm tra cấu hình email&lt;/b&gt;&lt;br&gt;&lt;br&gt;emailEnabled + địa chỉ người dùng đã xác minh; chỉ gửi tới người sở hữu account, không lấy recipient từ job." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_2" value="&lt;b&gt;03. Chọn finding cần thông báo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Finding mới/đổi đáng kể, không ignored; áp dụng cooldown và gom thành một digest mỗi lượt quét." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_3" value="&lt;b&gt;04. Tạo notification record&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conditional write giữ notificationId ổn định; chống gửi lặp khi scheduled event/worker được retry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_4" value="&lt;b&gt;05. Soạn email có bằng chứng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Resource, account, region, lý do, thời gian và link dashboard. Không kèm credentials hay dữ liệu nhạy cảm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_5" value="&lt;b&gt;06. Amazon SES SendEmail&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lambda dùng execution role có ses:SendEmail; sender identity được xác minh trong region triển khai." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_6" value="&lt;b&gt;07. SES chấp nhận yêu cầu&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lưu messageId và SENT nghĩa là SES nhận gửi; không đồng nghĩa email đã tới inbox." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_7" value="&lt;b&gt;08. Nếu SES lỗi / bị throttle&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ghi FAILED và retry có giới hạn; không đánh dấu scan tài nguyên FAILED chỉ vì gửi email lỗi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_8" value="&lt;b&gt;09. Theo dõi gửi khi mở rộng&lt;/b&gt;&lt;br&gt;&lt;br&gt;SES events cho bounce/complaint/delivery; suppress recipient lỗi. Cấu hình SES sandbox cần xác minh recipient." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail7_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail7_0" target="detail7_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail7_1" target="detail7_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail7_2" target="detail7_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail7_3" target="detail7_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail7_4" target="detail7_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail7_5" target="detail7_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail7_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Email là thành phần dự kiến trong mô hình bạn vẽ; cần cấu hình identity/quyền trước khi demo gửi thật.&lt;br&gt;• SES không bảo đảm exactly-once SendEmail. Record + cooldown giảm trùng; crash sau gửi có thể khiến kết quả gửi chưa rõ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="crg-detail-8" name="08 — Vận hành, quyền và luồng xử lý của người dùng"><mxGraphModel dx="1500" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="detail8_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="1140" as="geometry" /></mxCell><mxCell id="detail8_title" value="08 — Vận hành, quyền và luồng xử lý của người dùng" style="text;html=1;whiteSpace=wrap;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1430" height="48" as="geometry" /></mxCell><mxCell id="detail8_sub" value="Thiết kế dự kiến • Đọc theo mũi tên và số thứ tự • Chi tiết của mô hình tổng quan" style="text;html=1;fontSize=15;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="73" width="1430" height="30" as="geometry" /></mxCell><mxCell id="detail8_0" value="&lt;b&gt;01. Frontend hosting cần bổ sung&lt;/b&gt;&lt;br&gt;&lt;br&gt;S3 + CloudFront phục vụ HTML/JS qua HTTPS, hoặc hosting tương đương. Browser không phải dịch vụ lưu web." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_1" value="&lt;b&gt;02. Dashboard tập trung&lt;/b&gt;&lt;br&gt;&lt;br&gt;Xem trạng thái kết nối, lần quét gần nhất, lỗi/partial, bộ lọc resource/region và bằng chứng cảnh báo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_2" value="&lt;b&gt;03. Cấu hình qua form&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validate ngưỡng, thời gian, region; người dùng bật/tắt lịch, quét thủ công, ignore và thêm tag ngoại lệ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_3" value="&lt;b&gt;04. Kiểm tra trước khi xử lý&lt;/b&gt;&lt;br&gt;&lt;br&gt;Người dùng mở tài nguyên trong AWS Console, xác minh mục đích và ảnh hưởng tới ứng dụng/backup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_4" value="&lt;b&gt;05. Xử lý theo quyền hiện tại&lt;/b&gt;&lt;br&gt;&lt;br&gt;ReadRole chỉ đọc. MVP hướng dẫn stop/delete qua AWS Console rồi quét lại để xác nhận kết quả." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_5" value="&lt;b&gt;06. Tự động thao tác: mở rộng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nếu làm sau: ActionRole riêng, preview ảnh hưởng, xác nhận từng resource, recheck trạng thái và audit log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_6" value="&lt;b&gt;07. Execution role riêng từng Lambda&lt;/b&gt;&lt;br&gt;&lt;br&gt;API: DynamoDB + Invoke worker; scheduler: lịch/job + Invoke; worker: STS + DynamoDB + SES + logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_7" value="&lt;b&gt;08. CloudWatch Logs và Metrics&lt;/b&gt;&lt;br&gt;&lt;br&gt;Log có scanId/userId nội bộ, latency, counts, errors; tránh credentials, token và nội dung email đầy đủ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_8" value="&lt;b&gt;09. CloudWatch Alarm&lt;/b&gt;&lt;br&gt;&lt;br&gt;Theo dõi Lambda Errors/Throttles, duration, scan overdue, tỷ lệ partial và thất bại gửi email." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_9" value="&lt;b&gt;10. Giới hạn chi phí và tải&lt;/b&gt;&lt;br&gt;&lt;br&gt;Region allowlist, số resource, lịch tối thiểu, reserved concurrency. SDK paginate có giới hạn rõ ràng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_10" value="&lt;b&gt;11. Kiểm thử các tình huống&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hai user không đọc chéo; role bị thu hồi; metric thiếu; throttle; event lặp; scan partial; snapshot giữ lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_11" value="&lt;b&gt;12. Demo có thể kiểm chứng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tạo tài nguyên thử được phép, chạy quét, xem evidence, ignore, đổi ngưỡng và quét lại; ghi nhận kết quả thực tế." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#8094ac;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="420" height="140" as="geometry" /></mxCell><mxCell id="detail8_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail8_0" target="detail8_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail8_1" target="detail8_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail8_2" target="detail8_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail8_3" target="detail8_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52667f;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detail8_4" target="detail8_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="detail8_notes" value="&lt;b&gt;Ghi chú / điều kiện&lt;/b&gt;&lt;br&gt;• Các khối S3/CloudFront, monitoring và ActionRole được ghi rõ là bổ sung/mở rộng so với sơ đồ tổng quan gốc.&lt;br&gt;• Đây là thiết kế chi tiết dự kiến; hình vẽ không chứng minh hệ thống đã triển khai hoặc đã kiểm thử trên AWS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#cbd5e1;align=left;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>